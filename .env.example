# PHT Hygiene Webshop — DEMO (copy to .env)
# DEMO first: structure & flows. Go live only after demo is approved.
# Production: DEMO_MODE=false (boot fails otherwise when NODE_ENV=production)
DEMO_MODE="true"

# Local: relative SQLite file. Vercel demo: file:/tmp/pht-webshop-demo.db
# Production: prefer Postgres (postgresql://...)
DATABASE_URL="file:./dev.db"
# PUBLIC_DEMO_URL="https://pht-webshop.vercel.app"
# BACKUP_DIR="./backups"

# Admin login password (set a strong value in production, min 12 chars)
ADMIN_PASSWORD="change-me-pht-admin"

# Cookie session signing secret (min 32 characters, no placeholders in prod)
SESSION_SECRET="replace-with-long-random-secret-32chars"

# Ops: npm run ops:check-env | ops:backup | ops:smoke | ops:audit
# Runbook: docs/ops-runbook.md

# ---------------------------------------------------------------------------
# ERP adapters: mock | rest | business-central (alias: bc)
# ---------------------------------------------------------------------------
ERP_PROVIDER="mock"

# --- REST (generic / demo ERP) ---
# Start local demo: npm run erp:demo
# ERP_PROVIDER="rest"
ERP_BASE_URL="http://127.0.0.1:4010"
ERP_API_KEY="demo-erp-key"
ERP_WEBHOOK_SECRET=""
# Optional path overrides:
# ERP_PRODUCTS_PATH="/products"
# ERP_ORDERS_PATH="/orders"
# ERP_STOCK_PATH="/stock"
# ERP_HEALTH_PATH="/health"
# ERP_TIMEOUT_MS="30000"

# --- Microsoft Dynamics 365 Business Central (standalone, not Mastertool) ---
# ERP_PROVIDER="business-central"
# BC_TENANT_ID=""
# BC_CLIENT_ID=""
# BC_CLIENT_SECRET=""
# BC_ENVIRONMENT="Sandbox"
# BC_COMPANY_ID=""
# BC_ALLOW_WRITE="false"   # set true only for sandbox write tests
# BC_DEFAULT_CUSTOMER_NUMBER=""  # fallback if company has no erpCustomerId
# BC_CURRENCY_CODE="EUR"
