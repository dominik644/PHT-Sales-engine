# PHT Webshop (standalone) — copy to .env and fill in values
# Independent of PHT Mastertool: own DB, own admin, own deploy.
DATABASE_URL="file:./dev.db"

# Admin login password (set a strong value in production)
ADMIN_PASSWORD="change-me-pht-admin"

# Cookie session signing secret (min 32 characters)
SESSION_SECRET="replace-with-long-random-secret-32chars"

# ERP connection
# mock  = local demo ERP (creates order + invoice)
# rest  = generic REST ERP (Xentral, weclapp, custom middleware, …)
ERP_PROVIDER="mock"
ERP_BASE_URL="https://your-erp.example.com/api"
ERP_API_KEY=""
ERP_WEBHOOK_SECRET=""
