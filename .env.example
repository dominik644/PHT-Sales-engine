# PHT Sales Engine — copy to .env and fill in values
DATABASE_URL="file:./dev.db"

# Admin login password (set a strong value in production)
ADMIN_PASSWORD="change-me"

# Cookie session signing secret (min 32 characters)
SESSION_SECRET="replace-with-long-random-secret"

# ERP connection
# mock  = local demo ERP (no external system)
# rest  = generic REST ERP (Xentral, weclapp, custom middleware, …)
ERP_PROVIDER="mock"
ERP_BASE_URL="https://your-erp.example.com/api"
ERP_API_KEY=""
ERP_WEBHOOK_SECRET=""
